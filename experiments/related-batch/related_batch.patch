diff --git a/benchmarks/related_batch_benchmark.cpp b/benchmarks/related_batch_benchmark.cpp
new file mode 100644
index 0000000..53f9e7e
--- /dev/null
+++ b/benchmarks/related_batch_benchmark.cpp
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <related_batch.hpp>
+#include <algorithm>
+#include <bit>
+#include <fstream>
+#include <iostream>
+#include <numeric>
+#include <random>
+#include <set>
+#include <stdexcept>
+#include <string>
+using namespace related_batch;
+namespace {
+auto make_family(int cards,int count,unsigned seed,int trump,int constraint) -> Batch
+{
+    std::mt19937 rng(seed); std::array<int,52> deck{};
+    std::iota(deck.begin(),deck.end(),0); std::shuffle(deck.begin(),deck.end(),rng);
+    Batch b; b.trump=trump; b.first=3; std::vector<int> ew;
+    Defenders fixed{}; int need_e=cards;
+    for(int i=0;i<cards;++i) {
+        int n=deck[i],s=deck[13+i]; b.north[n/13]|=1u<<(n%13+2); b.south[s/13]|=1u<<(s%13+2);
+        for(int h=2;h<4;++h) {
+            int c=deck[13*h+i];
+            if(constraint==2&&c%13>=8) {
+                (h==2?fixed.east:fixed.west)[c/13]|=1u<<(c%13+2);
+                if(h==2) --need_e;
+            } else ew.push_back(c);
+        }
+    }
+    std::array<int,4> base_shape{}; int base_hcp=0;
+    for(int i=0;i<cards;++i) {int c=deck[26+i];++base_shape[c/13];base_hcp+=std::max(0,c%13-8);}
+    std::set<std::array<unsigned,4>> seen;
+    while(static_cast<int>(b.layouts.size())<count) {
+        std::shuffle(ew.begin(),ew.end(),rng); Defenders d=fixed;
+        for(std::size_t i=0;i<ew.size();++i) (static_cast<int>(i)<need_e?d.east:d.west)[ew[i]/13]|=1u<<(ew[i]%13+2);
+        if(constraint==1) {
+            int hcp=0; bool fits=true;
+            for(int s=0;s<4;++s) {
+                if(std::abs(std::popcount(d.east[s])-base_shape[s])>1) fits=false;
+                for(int r=11;r<=14;++r) if(d.east[s]&(1u<<r)) hcp+=r-10;
+            }
+            if(!fits||std::abs(hcp-base_hcp)>2) continue;
+        }
+        if(cards>=10&&!seen.insert(d.east).second) continue;
+        b.layouts.push_back(d);
+    }
+    validate(b); return b;
+}
+}
+auto main(int argc,char** argv) -> int
+{
+    const int families=argc>1?std::stoi(argv[1]):4, count=argc>2?std::stoi(argv[2]):1000;
+    const int repeats=argc>3?std::stoi(argv[3]):3,cards=argc>4?std::stoi(argv[4]):13;
+    const unsigned base=argc>5?std::stoul(argv[5]):20261118;
+    const std::string prefix=argc>6?argv[6]:"batch";
+    std::ofstream hands(prefix+"_hands.csv"), scores(prefix+"_scores.csv");
+    hands<<"family,constraint,index,trump,first"; for(int h=0;h<4;++h) for(int s=0;s<4;++s) hands<<",h"<<h<<"s"<<s; hands<<'\n';
+    scores<<"family,constraint,index,ns_tricks\n";
+    std::cout<<"family,constraint,cards,size,repeat,variant,total_ms,validation_ms,nodes,tt_lookups,tt_hits,root_full,root_partial,root_proofs,root_checks,shape_bound_hits,tt_mib\n";
+    for(int fi=0;fi<families;++fi) for(int constraint=0;constraint<3;++constraint) {
+        auto all=make_family(cards,count,base+fi,fi%5,constraint);
+        for(int i=0;i<count;++i) {auto dl=make_deal(all,i);hands<<fi<<','<<constraint<<','<<i<<','<<all.trump<<','<<all.first;
+            for(auto& h:dl.remainCards) { for(auto c:h) hands<<','<<c; }
+            hands<<'\n';}
+        hands.flush();
+        std::vector<int> sizes={1,4,16,64,256,count}; std::sort(sizes.begin(),sizes.end()); sizes.erase(std::unique(sizes.begin(),sizes.end()),sizes.end());
+        for(int size:sizes) {if(size>count) continue;auto b=all;b.layouts.resize(size);std::vector<int> ref;
+            for(int rep=0;rep<repeats;++rep) {
+                std::vector<int> modes={0,1,2,3,4};if(rep%2)std::reverse(modes.begin(),modes.end());
+                for(int variant:modes) {
+                    Options options;options.mode=variant==0?Mode::Cold:variant==1?Mode::Retained:Mode::RootProofs;options.sort_by_shape=variant==3;options.abstract_cash_bounds=variant==4;
+                    auto r=solve(b,options);
+                    if(ref.empty())ref=r.ns_tricks;
+                    if(r.ns_tricks!=ref) {std::cerr<<"MISMATCH family="<<fi<<" constraint="<<constraint<<" size="<<size<<" variant="<<variant<<'\n';return 2;}
+                    auto s=r.stats;
+                    std::cout<<fi<<','<<constraint<<','<<cards<<','<<size<<','<<rep<<','<<variant<<','<<s.total_ms<<','<<s.validation_ms<<','<<s.trick_nodes<<','<<s.tt_lookups<<','<<s.tt_hits<<','<<s.root_complete_hits<<','<<s.root_partial_hits<<','<<s.root_proofs<<','<<s.root_checks<<','<<s.shape_bound_hits<<','<<s.tt_mib<<'\n';std::cout.flush();
+                }
+            }
+            if(size==count)for(int i=0;i<count;++i)scores<<fi<<','<<constraint<<','<<i<<','<<ref[i]<<'\n';
+        }
+        scores.flush();
+    }
+}
