@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <gtest/gtest.h>
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <numeric>
+#include <random>
+#include <related_batch.hpp>
+#include <api/solve_board.hpp>
+using namespace related_batch;
+namespace {
+auto family(int cards,int count,unsigned seed,int trump=4,int first=3) -> Batch
+{
+    std::mt19937 rng(seed); std::array<int,52> deck{};
+    std::iota(deck.begin(),deck.end(),0); std::shuffle(deck.begin(),deck.end(),rng);
+    Batch b{}; b.trump=trump; b.first=first; std::vector<int> ew;
+    for(int i=0;i<cards;++i) {
+        int n=deck[i],s=deck[13+i]; b.north[n/13]|=1u<<(n%13+2); b.south[s/13]|=1u<<(s%13+2);
+        ew.push_back(deck[26+i]); ew.push_back(deck[39+i]);
+    }
+    for(int j=0;j<count;++j) {
+        std::shuffle(ew.begin(),ew.end(),rng); Defenders d{};
+        for(int i=0;i<2*cards;++i) (i<cards?d.east:d.west)[ew[i]/13]|=1u<<(ew[i]%13+2);
+        b.layouts.push_back(d);
+    }
+    return b;
+}
+auto reference(const Batch& b) -> std::vector<int>
+{
+    SolverContext ctx; std::vector<int> out;
+    for(std::size_t i=0;i<b.layouts.size();++i) {
+        const auto dl=make_deal(b,i); ctx.reset_for_solve(); FutureTricks f{};
+        EXPECT_EQ(solve_board(ctx,dl,-1,1,1,&f),RETURN_NO_FAULT);
+        int cards=0,partial=0;
+        for(auto& h:dl.remainCards) for(auto c:h) cards+=std::popcount(c);
+        for(auto r:b.current_trick_rank) partial+=(r!=0);
+        int tricks=(cards+partial)/4;
+        out.push_back(((b.first+partial)%2)?tricks-f.score[0]:f.score[0]);
+    }
+    return out;
+}
+}
+TEST(RelatedBatch, RejectsWholeBatchBeforeSolving)
+{
+    auto b=family(5,3,412); EXPECT_NO_THROW(validate(b));
+    auto bad=b; bad.layouts.clear(); EXPECT_THROW(validate(bad),std::invalid_argument);
+    bad=b; bad.trump=5; EXPECT_THROW(solve(bad),std::invalid_argument);
+    bad=b; bad.first=-1; EXPECT_THROW(validate(bad),std::invalid_argument);
+    bad=b; bad.north[0]|=1; EXPECT_THROW(validate(bad),std::invalid_argument);
+    bad=b; bad.south=b.north; EXPECT_THROW(validate(bad),std::invalid_argument);
+    bad=b; bad.layouts.back().east=bad.north; EXPECT_THROW(solve(bad),std::invalid_argument);
+    bad=b; bad.layouts[1].east={}; EXPECT_THROW(validate(bad),std::invalid_argument);
+}
+TEST(RelatedBatch, RejectsDifferentRemainingDeck)
+{
+    auto b=family(2,2,31); bool changed=false;
+    for(int s=0;s<4&&!changed;++s) for(int r=2;r<=14&&!changed;++r) {
+        auto bit=1u<<r; auto& d=b.layouts[1];
+        if(!(bit&(b.north[s]|b.south[s]|d.east[s]|d.west[s])))
+            for(int t=0;t<4&&!changed;++t) if(d.east[t]) {
+                d.east[t]&=d.east[t]-1; d.east[s]|=bit; changed=true;
+            }
+    }
+    ASSERT_TRUE(changed); EXPECT_THROW(validate(b),std::invalid_argument);
+}
+TEST(RelatedBatch, ModesAgreeWithIndependentNativeSolves)
+{
+    for(int trump=0;trump<5;++trump) for(int first=0;first<4;++first) {
+        auto b=family(5,25,815+trump*4+first,trump,first); auto expected=reference(b);
+        for(auto mode:{Mode::Cold,Mode::Retained,Mode::RootProofs}) {
+            Options o; o.mode=mode; EXPECT_EQ(solve(b,o).ns_tricks,expected);
+            o.sort_by_shape=true; EXPECT_EQ(solve(b,o).ns_tricks,expected);
+        }
+    }
+}
+TEST(RelatedBatch, DuplicateLayoutsUseRootProofs)
+{
+    auto b=family(8,1,9143); b.layouts.resize(20,b.layouts[0]);
+    Options o; o.mode=Mode::RootProofs; auto result=solve(b,o);
+    EXPECT_EQ(result.ns_tricks,reference(b)); EXPECT_EQ(result.stats.root_complete_hits,19u);
+}
+TEST(RelatedBatch, PartialTricksAreValidatedAndSolved)
+{
+    for(int partial=1;partial<=3;++partial) {
+        auto b=family(5,1,223+partial,partial%5,3);
+        for(int i=0;i<partial;++i) {
+            int hand=(b.first+i)%4;
+            auto* h=hand==0?&b.north:hand==2?&b.south:hand==1?&b.layouts[0].east:&b.layouts[0].west;
+            int suit=0;
+            if(i&&(*h)[b.current_trick_suit[0]]) suit=b.current_trick_suit[0];
+            else while(!(*h)[suit]) ++suit;
+            int rank=std::countr_zero((*h)[suit]); (*h)[suit]^=1u<<rank;
+            b.current_trick_suit[i]=suit; b.current_trick_rank[i]=rank;
+        }
+        b.layouts.resize(4,b.layouts[0]); EXPECT_NO_THROW(validate(b));
+        Options o; o.mode=Mode::RootProofs; EXPECT_EQ(solve(b,o).ns_tricks,reference(b));
+        auto bad=b; bad.current_trick_rank[0]=0; EXPECT_THROW(validate(bad),std::invalid_argument);
+        bad=b; bad.current_trick_rank[0]=15; EXPECT_THROW(validate(bad),std::invalid_argument);
+    }
+}
+TEST(RelatedBatch, LastTrickAndFullDeal)
+{
+    for(int trump=0;trump<5;++trump) {
+        auto b=family(1,30,567+trump,trump); EXPECT_EQ(solve(b).ns_tricks,reference(b));
+    }
+    auto b=family(13,8,2911); Options o; o.mode=Mode::RootProofs;
+    EXPECT_EQ(solve(b,o).ns_tricks,reference(b));
+}
+TEST(RelatedBatch, AbstractCashCertificateCoversDifferentDefenderShapes)
+{
+    Batch b; b.first=0; b.trump=4; b.north[0]=(1u<<14)|(1u<<13)|(1u<<12);
+    b.south[3]=(1u<<2)|(1u<<3)|(1u<<4);
+    std::array<unsigned,6> cards={2,3,4,15,16,17};
+    for(unsigned bits=0;bits<64;++bits) if(std::popcount(bits)==3) {
+        Defenders d;
+        for(int i=0;i<6;++i) (bits&(1u<<i)?d.east:d.west)[cards[i]/13+1]|=1u<<(cards[i]%13);
+        b.layouts.push_back(d);
+    }
+    Options o; o.abstract_cash_bounds=true;
+    auto r=solve(b,o); EXPECT_EQ(r.ns_tricks,reference(b));
+    EXPECT_EQ(r.stats.native_solves,0u); EXPECT_EQ(r.stats.shape_bound_hits,20u);
+    // A heart ruff invalidates cashing side-suit winners across these shapes.
+    b.trump=1; EXPECT_EQ(solve(b,o).ns_tricks,reference(b));
+}
+TEST(RelatedBatch, AbstractBoundsAndTinyCacheAgreeWithNative)
+{
+    for(int seed=0;seed<10;++seed) {
+        auto b=family(6,100,929+seed,seed%5,seed%4); auto ref=reference(b);
+        Options o; o.abstract_cash_bounds=true; o.max_root_proofs=3;o.max_proofs_per_shape=1;o.memory_mb=1;
+        EXPECT_EQ(solve(b,o).ns_tricks,ref);
+    }
+}
+namespace {
+auto brute(Deal& dl,std::array<int,4>& table,int leader,int played,int remaining) -> int
+{
+    if(!remaining) return 0;
+    int hand=(leader+played)%4, best=(hand%2)?99:-1;
+    int led=played?table[0]/15:-1;
+    for(int suit=0;suit<4;++suit) {
+        if(played&&dl.remainCards[hand][led]&&suit!=led) continue;
+        unsigned mask=dl.remainCards[hand][suit];
+        while(mask) {
+            int rank=std::countr_zero(mask); mask&=mask-1;
+            auto old=table; table[played]=15*suit+rank;
+            dl.remainCards[hand][suit]^=1u<<rank; int value;
+            if(played==3) {
+                int winner=0;
+                for(int j=1;j<4;++j) {
+                    int a=table[j]/15,b=table[winner]/15;
+                    if((a==b&&table[j]%15>table[winner]%15)||(a==dl.trump&&b!=dl.trump)) winner=j;
+                }
+                int seat=(leader+winner)%4;
+                value=(seat%2==0)+brute(dl,table,seat,0,remaining-1);
+            } else value=brute(dl,table,leader,played+1,remaining-1);
+            dl.remainCards[hand][suit]|=1u<<rank;table=old;
+            best=hand%2?std::min(best,value):std::max(best,value);
+        }
+    }
+    return best;
+}
+}
+TEST(RelatedBatch, ExhaustiveThreeCardDefensesMatchIndependentMinimax)
+{
+    for(int seed=0;seed<3;++seed) for(int trump=0;trump<5;++trump) for(int first=0;first<4;++first) {
+        auto b=family(3,1,93041+seed,trump,first); std::vector<std::pair<int,int>> cards;
+        for(int s=0;s<4;++s) for(int r=2;r<=14;++r)
+            if((b.layouts[0].east[s]|b.layouts[0].west[s])&(1u<<r))cards.emplace_back(s,r);
+        b.layouts.clear();
+        for(unsigned bits=0;bits<64;++bits) if(std::popcount(bits)==3) {
+            Defenders d;
+            for(int i=0;i<6;++i)(bits&(1u<<i)?d.east:d.west)[cards[i].first]|=1u<<cards[i].second;
+            b.layouts.push_back(d);
+        }
+        std::vector<int> expected;
+        for(std::size_t i=0;i<b.layouts.size();++i) {
+            auto dl=make_deal(b,i); std::array<int,4> table{};
+            expected.push_back(brute(dl,table,first,0,12));
+        }
+        Options o; o.abstract_cash_bounds=true;
+        EXPECT_EQ(solve(b,o).ns_tricks,expected);
+    }
+}
+TEST(RelatedBatch, VariedLayoutsAfterOneTwoOrThreeKnownCards)
+{
+    for(int seed=0;seed<5;++seed) for(int partial=1;partial<=3;++partial) {
+        auto source=family(7,400,76000+seed,seed,seed%4); Batch b=source; b.layouts.clear();
+        auto chosen=make_deal(source,0);
+        for(int k=0;k<partial;++k) {
+            int hand=(source.first+k)%4,suit=0;
+            if(k&&chosen.remainCards[hand][b.current_trick_suit[0]]) suit=b.current_trick_suit[0];
+            else while(!chosen.remainCards[hand][suit])++suit;
+            int rank=std::countr_zero(chosen.remainCards[hand][suit]);
+            b.current_trick_suit[k]=suit;b.current_trick_rank[k]=rank;
+            if(hand==0)b.north[suit]^=1u<<rank;
+            if(hand==2)b.south[suit]^=1u<<rank;
+        }
+        for(std::size_t i=0;i<source.layouts.size();++i) {
+            auto dl=make_deal(source,i);bool valid=true;
+            for(int k=0;k<partial;++k) {
+                int h=(b.first+k)%4,s=b.current_trick_suit[k],r=b.current_trick_rank[k];
+                if(!(dl.remainCards[h][s]&(1u<<r))) {valid=false;break;}
+                if(k&&s!=b.current_trick_suit[0]&&dl.remainCards[h][b.current_trick_suit[0]]) {valid=false;break;}
+                dl.remainCards[h][s]^=1u<<r;
+            }
+            if(valid) {
+                Defenders d;for(int s=0;s<4;++s){d.east[s]=dl.remainCards[1][s];d.west[s]=dl.remainCards[3][s];}
+                b.layouts.push_back(d);
+            }
+        }
+        ASSERT_FALSE(b.layouts.empty());Options o;o.abstract_cash_bounds=true;
+        EXPECT_EQ(solve(b,o).ns_tricks,reference(b));
+    }
+}
+TEST(RelatedBatch, RejectsRevokeAndCurrentTrickDuplication)
+{
+    Batch b; b.first=3; b.trump=4;
+    b.north[0]=1u<<14;b.north[1]=1u<<14;b.south[2]=(1u<<14)|(1u<<13);
+    Defenders d;d.east[3]=(1u<<14)|(1u<<13);d.west[0]=1u<<13;b.layouts={d};
+    b.current_trick_suit[0]=0;b.current_trick_rank[0]=12;
+    EXPECT_NO_THROW(validate(b));
+    auto bad=b;bad.layouts[0].west[0]|=1u<<12;EXPECT_THROW(validate(bad),std::invalid_argument);
+    // North discards HA but still holds SA.
+    bad=b;bad.north[1]=0;bad.current_trick_suit[1]=1;bad.current_trick_rank[1]=14;
+    EXPECT_THROW(validate(bad),std::invalid_argument);
+}
+TEST(RelatedBatch, ExhaustiveFourCardAllocationsExerciseGeneralizedRootHits)
+{
+    std::size_t hits=0;
+    for(int seed=0;seed<20;++seed) for(int trump=0;trump<5;++trump) {
+        auto b=family(4,1,37120+seed,trump,seed%4);
+        std::vector<std::pair<int,int>> cards;
+        for(int s=0;s<4;++s) for(int r=2;r<=14;++r)
+            if((b.layouts[0].east[s]|b.layouts[0].west[s])&(1u<<r))cards.emplace_back(s,r);
+        b.layouts.clear();
+        for(unsigned bits=0;bits<256;++bits) if(std::popcount(bits)==4) {
+            Defenders d;
+            for(int i=0;i<8;++i)(bits&(1u<<i)?d.east:d.west)[cards[i].first]|=1u<<cards[i].second;
+            b.layouts.push_back(d);
+        }
+        auto expected=reference(b);
+        Options o;o.sort_by_shape=true;
+        auto r=solve(b,o); EXPECT_EQ(r.ns_tricks,expected);
+        hits+=r.stats.root_complete_hits;
+    }
+    EXPECT_GT(hits,0u);
+}
diff --git a/library/src/related_batch.cpp b/library/src/related_batch.cpp
