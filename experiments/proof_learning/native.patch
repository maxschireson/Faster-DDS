diff --git a/benchmarks/proof_learning.cpp b/benchmarks/proof_learning.cpp
new file mode 100644
index 0000000..32137db
--- /dev/null
+++ b/benchmarks/proof_learning.cpp
@@ -0,0 +1,231 @@
+// Offline self-play scavenger. Every output remains an exact DDS result.
+#include <proof_model.hpp>
+#include <research_teacher.hpp>
+#include <api/solve_board.hpp>
+#include <lookup_tables/lookup_tables.hpp>
+#include <algorithm>
+#include <array>
+#include <ctime>
+#include <fstream>
+#include <iostream>
+#include <iomanip>
+#include <memory>
+#include <set>
+#include <string>
+
+namespace {
+
+auto cpu_seconds() -> double { return static_cast<double>(std::clock()) / CLOCKS_PER_SEC; }
+
+auto scores(const FutureTricks& result) -> std::array<int, 52>
+{
+    std::array<int, 52> output{};
+    output.fill(-1);
+    for (int i = 0; i < result.cards; ++i)
+        for (int rank = 2; rank <= 14; ++rank)
+            if ((result.equals[i] | (1 << result.rank[i])) & (1 << rank))
+                output[result.suit[i] * 13 + rank - 2] = result.score[i];
+    return output;
+}
+
+auto solve(SolverContext& context, const Deal& deal, dds_research::Research* research) -> FutureTricks
+{
+    context.reset_for_solve();
+    dds_research::ActiveGuard guard(research);
+    FutureTricks result{};
+    const int code = solve_board(context, deal, -1, 3, 1, &result);
+    if (code != RETURN_NO_FAULT) throw std::runtime_error("DDS solve error " + std::to_string(code));
+    return result;
+}
+
+auto label(std::ostream& out, const std::string& family, int root,
+           const dds_research::Decision& decision, SolverContext& shadow) -> void
+{
+    const auto& key = decision.key;
+    const auto parent = dds_research::deal_from_key(key);
+    const int actor = (key[17] + key[18]) % 4;
+    const int tricks = (key[24] + 7) / 4;
+    const bool is_max = (actor % 2 == 0) == (key[20] != 0);
+    const int residual = static_cast<std::int16_t>(key[16]);
+    const int need = is_max ? residual : tricks - residual + 1;
+    out << "{\"family\":\"" << family << "\",\"root\":" << root << ",\"key\":[";
+    for (std::size_t i = 0; i < key.size(); ++i) out << (i ? "," : "") << key[i];
+    out << "],\"parent_nodes\":" << decision.cost << ",\"moves\":[";
+    bool first = true;
+    for (const auto& move : decision.moves) {
+        const auto q = dds_research::child_query(parent, key[18], tricks, need, move.suit, move.rank);
+        std::uint64_t cost = 0;
+        bool succeeds = false;
+        if (q.trivial != -1) succeeds = static_cast<bool>(q.trivial) == q.want_success;
+        else {
+            shadow.reset_for_solve();
+            dds_research::Research probe;
+            probe.count_only = true;
+            dds_research::ActiveGuard guard(&probe);
+            FutureTricks result{};
+            const int code = solve_board(shadow, q.deal, q.target, 1, 1, &result);
+            if (code != RETURN_NO_FAULT) throw std::runtime_error("Teacher solve error");
+            succeeds = (result.score[0] >= q.target) == q.want_success;
+            cost = probe.nodes;
+        }
+        out << (first ? "" : ",") << '[' << move.suit * 13 + move.rank - 2
+            << ',' << succeeds << ',' << cost << ']';
+        first = false;
+    }
+    out << "]}\n";
+}
+
+struct ModelHook
+{
+    const dds_proof::Model& model;
+    int calls = 0;
+    int cap = 8;
+    int min_depth = 99;
+    int max_depth = -1;
+    static auto choose(const dds_research::Key& key, const MovePlyType& moves, void* context)
+        -> dds_research::Hint
+    {
+        auto& self = *static_cast<ModelHook*>(context);
+        if (self.calls >= self.cap) return {-1, 0, 0};
+        ++self.calls;
+        self.min_depth = std::min(self.min_depth, static_cast<int>(key[24]));
+        self.max_depth = std::max(self.max_depth, static_cast<int>(key[24]));
+        return self.model.choose(key, moves);
+    }
+};
+
+auto infer(const std::string& model_path, const std::string& input_path, const std::string& output_path) -> void
+{
+    dds_proof::Model model(model_path);
+    std::ifstream input(input_path);
+    std::ofstream output(output_path);
+    if (!input || !output) throw std::runtime_error("Cannot open inference fixture");
+    std::vector<std::pair<dds_research::Key, MovePlyType>> cases;
+    dds_research::Key key{};
+    while (input >> key[0]) {
+        for (std::size_t i = 1; i < key.size(); ++i)
+            if (!(input >> key[i])) throw std::runtime_error("Truncated inference key");
+        MovePlyType moves{};
+        int count = 0;
+        if (!(input >> count) || count < 1 || count > 13) throw std::runtime_error("Invalid move count");
+        moves.last = count - 1;
+        for (int i = 0; i < count; ++i) {
+            int card = 0;
+            if (!(input >> card) || card < 0 || card >= 52) throw std::runtime_error("Invalid card");
+            moves.move[i].suit = card / 13; moves.move[i].rank = card % 13 + 2;
+        }
+        cases.emplace_back(key, moves);
+        const auto y = model.evaluate(dds_proof::features(key, moves));
+        output << '[' << std::setprecision(9);
+        for (std::size_t i = 0; i < y.size(); ++i) output << (i ? "," : "") << y[i];
+        output << "]\n";
+    }
+    if (cases.empty()) throw std::runtime_error("No inference cases");
+    int checksum = 0;
+    const double start = cpu_seconds();
+    for (int repeat = 0; repeat < 100; ++repeat)
+        for (const auto& [position, moves] : cases)
+            checksum += model.choose(position, moves).rank;
+    output << "{\"microseconds_per_choice\":" << (cpu_seconds() - start) * 1e6 / (100 * cases.size())
+        << ",\"choices\":" << 100 * cases.size() << ",\"checksum\":" << checksum << "}\n";
+}
+
+} // namespace
+
+auto main(int argc, char** argv) -> int
+{
+    try {
+        if (argc == 5 && std::string(argv[1]) == "infer") {
+            infer(argv[2], argv[3], argv[4]); return 0;
+        }
+        if (argc < 4) throw std::runtime_error("Usage: proof_learning collect|evaluate ROOTS OUTPUT [MODEL] [CAP] [LEVELS] [MIN_TRICKS]");
+        const bool collect = std::string(argv[1]) == "collect";
+        if (!collect && (std::string(argv[1]) != "evaluate" || argc < 5))
+            throw std::runtime_error("Invalid command");
+        const int levels = argc > 6 ? std::stoi(argv[6]) : 5;
+        const int min_tricks = argc > 7 ? std::stoi(argv[7]) : 1;
+        if (levels < 1 || levels > 49 || min_tricks < 1 || min_tricks > 13)
+            throw std::runtime_error("Invalid root gate");
+        std::ifstream input(argv[2]);
+        std::ofstream output(argv[3]);
+        if (!input || !output) throw std::runtime_error("Cannot open input/output");
+        init_lookup_tables();
+        SolverContext baseline_context, shadow;
+        std::unique_ptr<dds_proof::Model> model;
+        if (!collect) model = std::make_unique<dds_proof::Model>(argv[4]);
+        std::set<dds_research::Key> seen;
+        std::string family;
+        int root = 0, count = 0;
+        while (input >> family >> root) {
+            dds_research::Key key{};
+            for (auto& word : key) if (!(input >> word)) throw std::runtime_error("Truncated root");
+            if (key[17] > 3 || key[18] > 3 || key[19] > 4 || key[24] > 48)
+                throw std::runtime_error("Invalid root metadata");
+            const auto deal = dds_research::deal_from_key(key);
+            if (collect) {
+                dds_research::Research research;
+                research.learn = false;
+                research.collect_decisions = true;
+                research.min_depth = std::max(0, static_cast<int>(key[24]) - 4);
+                research.decision_min_nodes = 64;
+                const auto reference = solve(baseline_context, deal, nullptr);
+                const auto instrumented = solve(baseline_context, deal, &research);
+                if (scores(reference) != scores(instrumented)) throw std::runtime_error("Collector changed scores");
+                std::stable_sort(research.decisions.begin(), research.decisions.end(),
+                    [](const auto& a, const auto& b) { return a.cost > b.cost; });
+                int emitted = 0;
+                for (const auto& decision : research.decisions) {
+                    // Deduplicate exact states before partitioning by family.
+                    if (!seen.insert(decision.key).second) continue;
+                    label(output, family, root, decision, shadow);
+                    if (++emitted == 8) break;
+                }
+            } else {
+                double baseline_time = 0, model_time = 0;
+                std::uint64_t baseline_nodes = 0, model_nodes = 0;
+                int calls = 0;
+                int min_model_depth = 99, max_model_depth = -1;
+                // Alternate order; repeat to reduce noise on small calls.
+                for (int repeat = 0; repeat < 3; ++repeat) {
+                    std::array<int, 52> reference{}, guided{};
+                    for (int pass = 0; pass < 2; ++pass) {
+                        const bool use_model = (pass + repeat + count) % 2;
+                        const bool enabled = use_model && (key[24] + 7) / 4 >= min_tricks;
+                        dds_research::Research state;
+                        state.learn = false;
+                        state.count_only = !enabled;
+                        ModelHook hook{*model};
+                        if (argc > 5) hook.cap = std::stoi(argv[5]);
+                        state.min_depth = std::max(0, static_cast<int>(key[24]) - levels + 1);
+                        state.apply = enabled;
+                        state.teacher_hook = enabled ? &ModelHook::choose : nullptr;
+                        state.teacher_context = &hook;
+                        const double start = cpu_seconds();
+                        const auto result = solve(baseline_context, deal, &state);
+                        const double elapsed = cpu_seconds() - start;
+                        if (use_model) {
+                            guided = scores(result); model_time += elapsed; model_nodes += state.nodes; calls += hook.calls;
+                            min_model_depth = std::min(min_model_depth, hook.min_depth);
+                            max_model_depth = std::max(max_model_depth, hook.max_depth);
+                        } else { reference = scores(result); baseline_time += elapsed; baseline_nodes += state.nodes; }
+                    }
+                    if (reference != guided) throw std::runtime_error("Model changed exact all-move scores");
+                }
+                output << "{\"family\":\"" << family << "\",\"root\":" << root
+                    << ",\"baseline_seconds\":" << baseline_time << ",\"model_seconds\":" << model_time
+                    << ",\"baseline_nodes\":" << baseline_nodes << ",\"model_nodes\":" << model_nodes
+                    << ",\"model_calls\":" << calls << ",\"root_depth\":" << key[24]
+                    << ",\"min_model_depth\":" << min_model_depth << ",\"max_model_depth\":" << max_model_depth
+                    << ",\"all_moves_equal\":true}\n";
+            }
+            output.flush();
+            if (++count % 25 == 0) std::cerr << "processed " << count << " roots\n";
+        }
+        if (!input.eof()) throw std::runtime_error("Invalid input record");
+        if (!output) throw std::runtime_error("Output write failed");
+        std::cerr << "completed " << count << " roots\n";
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n'; return 1;
+    }
+    return 0;
+}
