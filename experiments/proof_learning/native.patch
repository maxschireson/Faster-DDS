+#include <proof_model.hpp>
+#include <gtest/gtest.h>
+
+TEST(ProofModel, RotatesHoldingsAndConditionsOnCurrentSideTarget)
+{
+    dds_research::Key key{};
+    key[4] = 1 << 12;
+    key[16] = 7; key[17] = 0; key[18] = 1;
+    key[19] = 4; key[20] = 1; key[21] = 2; key[24] = 47;
+    MovePlyType moves{};
+    moves.last = 0; moves.move[0].suit = 0; moves.move[0].rank = 14;
+    const auto x = dds_proof::features(key, moves);
+    EXPECT_EQ(x[12], 1);
+    EXPECT_EQ(x[208], 1);
+    EXPECT_FLOAT_EQ(x[373], 7.0f / 13);
+    EXPECT_EQ(x[387], 1);
+}
+
+TEST(ProofModel, RejectsInvalidNetworkHeader)
+{
+    EXPECT_THROW(dds_proof::Model("/nonexistent/proof-model"), std::runtime_error);
+}
