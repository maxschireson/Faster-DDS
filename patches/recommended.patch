diff --git a/benchmarks/kernel_benchmark.cpp b/benchmarks/kernel_benchmark.cpp
new file mode 100644
index 0000000..8545b94
--- /dev/null
+++ b/benchmarks/kernel_benchmark.cpp
@@ -0,0 +1,62 @@
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <iostream>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include <api/solve_board.hpp>
+
+auto main(int argc, char** argv) -> int
+{
+    const int count = argc > 1 ? std::stoi(argv[1]) : 200;
+    const unsigned seed = argc > 2 ? std::stoul(argv[2]) : 5197319;
+    const int requested_cards = argc > 3 ? std::stoi(argv[3]) : 13;
+    const int solutions = argc > 4 ? std::stoi(argv[4]) : 1;
+    std::mt19937 rng(seed);
+    SolverContext ctx;
+    (void)ctx.trans_table();
+    std::cout << "deal,strain,cards,first,nanoseconds,trick_nodes,score,signature\n";
+    for (int deal_index = 0; deal_index < count; ++deal_index) {
+        std::array<int, 52> deck;
+        std::iota(deck.begin(), deck.end(), 0);
+        std::shuffle(deck.begin(), deck.end(), rng);
+        Deal deal{};
+        deal.first = deal_index % 4;
+        const int cards = requested_cards == 0 ? 3 + deal_index % 7 : requested_cards;
+        for (int hand = 0; hand < 4; ++hand)
+            for (int index = 0; index < cards; ++index) {
+                const int card = deck[13 * hand + index];
+                deal.remainCards[hand][card / 13] |= 1u << (card % 13 + 2);
+            }
+        for (int strain = 0; strain < 5; ++strain) {
+            deal.trump = strain;
+            ctx.reset_for_solve(); // Cold search cache; retain the allocated context.
+            FutureTricks result{};
+            const auto start = std::chrono::steady_clock::now();
+            const int rc = solve_board(ctx, deal, -1, solutions, 1, &result);
+            const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now() - start).count();
+            if (rc != RETURN_NO_FAULT) throw std::runtime_error("DDS returned " + std::to_string(rc));
+            std::vector<std::pair<int, int>> scores;
+            if (solutions == 3) {
+                for (int index = 0; index < result.cards; ++index) {
+                    scores.emplace_back(15 * result.suit[index] + result.rank[index], result.score[index]);
+                    for (int rank = 2; rank <= 14; ++rank)
+                        if (result.equals[index] & (1 << rank))
+                            scores.emplace_back(15 * result.suit[index] + rank, result.score[index]);
+                }
+                std::sort(scores.begin(), scores.end());
+            }
+            std::cout << deal_index << ',' << strain << ',' << cards << ',' << deal.first << ','
+                      << elapsed << ',' << result.nodes << ',' << result.score[0] << ',';
+            for (const auto& [card, score] : scores) std::cout << card << ':' << score << ';';
+            std::cout << '\n';
+        }
+        std::cout.flush();
+    }
+}
diff --git a/library/tests/ab_search/kernel_optimizations_test.cpp b/library/tests/ab_search/kernel_optimizations_test.cpp
new file mode 100644
index 0000000..8460c1d
--- /dev/null
+++ b/library/tests/ab_search/kernel_optimizations_test.cpp
@@ -0,0 +1,34 @@
+#include <algorithm>
+
+#include <gtest/gtest.h>
+
+#include <init.hpp>
+#include <lookup_tables/lookup_tables.hpp>
+#include <solver_context/solver_context.hpp>
+
+TEST(CompactRanks, FitsWithin256KiBPerContext)
+{
+    EXPECT_LE(8192 * sizeof(RelRanksType), 256u * 1024u);
+}
+
+TEST(CompactRanks, TopThreeAgreeWithIndependentScanForEveryMask)
+{
+    SolverContext ctx;
+    auto* thr = ctx.thread_ptr();
+    for (int suit = 0; suit < 4; ++suit)
+        for (int rank = 2; rank <= 14; ++rank)
+            thr->suit[(rank + suit) % 4][suit] |= bit_map_rank[rank];
+    SetDealTables(ctx);
+    for (int mask = 0; mask < 8192; ++mask) {
+        for (int suit = 0; suit < 4; ++suit) {
+            int cursor = 14;
+            for (int ordinal = 1; ordinal <= 3; ++ordinal) {
+                while (cursor >= 2 && !(mask & bit_map_rank[cursor])) --cursor;
+                const auto card = thr->rel[mask].abs_rank[ordinal][suit];
+                ASSERT_EQ(card.rank, cursor >= 2 ? cursor : 0);
+                ASSERT_EQ(card.hand, cursor >= 2 ? (cursor + suit) % 4 : -1);
+                --cursor;
+            }
+        }
+    }
+}
